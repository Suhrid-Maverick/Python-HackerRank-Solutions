import sys

def main():
    data = sys.stdin.read().split()
    idx = 0
    t = int(data[idx]); idx += 1
    out = []
    for _ in range(t):
        n = int(data[idx]); idx += 1
        a = set(data[idx:idx + n]); idx += n
        m = int(data[idx]); idx += 1
        b = set(data[idx:idx + m]); idx += m
        out.append(str(a <= b))
    sys.stdout.write("\n".join(out))

main()
